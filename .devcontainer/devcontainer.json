{
    "name": "Cdrom Dev Environment",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "golang.go",
                "ms-azuretools.vscode-azurecli",
                "ms-azuretools.vscode-docker",
                "mtxr.sqltools",
                "mtxr.sqltools-driver-sqlite",
                "mtxr.sqltools-driver-pg",
                "ollama.ollama"
            ],
            "settings": {
                "sqltools.connections": [
                    {
                        "previewLimit": 50,
                        "driver": "SQLite",
                        "name": "local",
                        "database": "${workspaceFolder:cdrom}/cdrom.db"
                    }
                ],
                "sqltools.useNodeRuntime": true
            }
        }
    },
    "mounts": [
        "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind",
        "source=${localEnv:HOME}/.azure,target=/home/vscode/.azure,type=bind",
        "source=${localEnv:HOME}/.config/ggshield,target=/home/vscode/.config/ggshield,type=bind"
    ],
    "remoteUser": "vscode",
    "features": {
        "ghcr.io/devcontainers/features/node:2": {}
    }
}